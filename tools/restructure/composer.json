{
  "name": "bitapps/bit-integrations-restructure-tools",
  "description": "Codemod and contract checks for moving action backends to the Action/Service/Helper layout. Not shipped.",
  "license": "GPL-2.0-or-later",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "nikic/php-parser": "^5.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "php-stubs/wordpress-stubs": "^6.5",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "BitApps\\Restructure\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
